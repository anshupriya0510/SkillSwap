# ─────────────────────────────────────────────────────────────────────────────
# SkillSwap — Environment Variables Template
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend (server/) ─────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillswap?retryWrites=true&w=majority
# Note: URL-encode special characters in the password (e.g. @ → %40, # → %23)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillswap?retryWrites=true&w=majority

# Express server port (Render sets this automatically — don't override in Render env vars)
PORT=5000

# Node environment: "development" or "production"
NODE_ENV=development

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://skillswap.vercel.app  or  https://skillswap.vercel.app,https://www.skillswap.vercel.app
CLIENT_URL=https://your-skillswap.vercel.app

# ── Frontend (Vite / src/) ────────────────────────────────────────────────────

# Full URL to the backend /api prefix — set this in Vercel environment variables
# Example: https://skillswap-api.onrender.com/api
VITE_API_URL=https://your-backend.onrender.com/api
